# 依赖与运行时产物
node_modules/
__pycache__/
*.py[cod]

# 本地配置：可能包含交换机地址、账号信息
config.json
*.cfg

# 面板的运行时数据：设备表 (含加密后的设备密码)、密钥文件、面板账号、设置。任何情况下都不要提交
app/data/

# 探测脚本的会话缓存与日志
tools/.session.json
tools/*.session.json
*.log

# 调研用的第三方源码，仅本地保留，不入库
_ref/

# 本地 AI 助手工作目录
.zcode/
.workbuddy/

# 编辑器与系统垃圾
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
